# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# The Vite dev server. Comma-separate to allow several origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Security ────────────────────────────────────────────
# Signs session tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage ─────────────────────────────────────────────
# JSON file database, created on first run.
DATA_FILE=./data/db.json

# ── AI assistant ────────────────────────────────────────
# Leave AI_API_KEY empty (or AI_MOCK=true) → the built-in MOCK assistant answers (free, offline,
# rule-based). Fill it in → a real LLM is used through any OpenAI-compatible
# Chat Completions API. Pick ONE provider block below.
# Set AI_MOCK=true to force the mock assistant even when a key is set.
AI_MOCK=false
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_TIMEOUT_MS=60000

# OpenRouter (free models end with ":free"; list: https://openrouter.ai/models?max_price=0)
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=<a model id ending in :free>
# Groq (free tier, very fast; keys: https://console.groq.com/keys)
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
# Google Gemini (free tier; keys: https://aistudio.google.com/apikey)
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.6-flash
# Local Ollama (no key needed, but set any non-empty value)
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=llama3.2
